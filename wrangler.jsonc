{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hazey",
  "account_id": "ce0cad81ccf18f3ac233cbf57b655270",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },
  "d1_databases": [{
    "binding": "PSI_DB",
    "database_name": "hazey-psi",
    "database_id": "99e28f2e-26d1-4a44-8718-30a3b8b3bce2",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "TELEGRAM_BOT_USERNAME": "",
    "PUBLIC_APP_URL": "https://hazey.gabrieltang515.workers.dev"
  }
}
